# Database Connection (Neon / PostgreSQL)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/payload_cms

# Payload CMS Secret Key (generate a strong random string)
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Server & Public Domain URLs (e.g. https://heysh1n.com.tr in production)
NEXT_PUBLIC_SERVER_URL=https://heysh1n.com.tr
ALLOWED_ORIGINS=https://heysh1n.com.tr,https://www.heysh1n.com.tr

# SFCP Licensing Module
SFCP_LATEST_VERSION=1.0.0
SFCP_DOWNLOAD_URL=https://heysh1n.com.tr/downloads/sfcp.zip
SFCP_SHA256=

# Cloudflare Deploy Webhook (Triggers static rebuild in Cloudflare Pages / Workers on content updates)
CLOUDFLARE_WEBHOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/your-deploy-hook-id
