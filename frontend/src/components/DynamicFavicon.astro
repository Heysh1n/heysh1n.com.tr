---
interface Props {
  discordId: string;
  defaultIcon?: string;
}

const { discordId, defaultIcon = '/favicon.svg' } = Astro.props;
---

<script is:inline define:vars={{ discordId, defaultIcon }}>
  (() => {
    if (!discordId) return;

    const LANYARD_WS = 'wss://api.lanyard.rest/socket';
    const LANYARD_REST = `https://api.lanyard.rest/v1/users/${discordId}`;
    const IMAGE_TIMEOUT_MS = 5000;

    let currentFaviconUrl = defaultIcon;
    let heartbeatTimer = null;
    let socket = null;
    let reconnectTimer = null;
    let updateSeq = 0;

    function detectIconType(url) {
      const clean = String(url).split('?')[0].toLowerCase();
      if (clean.endsWith('.svg')) return 'image/svg+xml';
      if (clean.endsWith('.ico')) return 'image/x-icon';
      if (clean.endsWith('.webp')) return 'image/webp';
      if (clean.endsWith('.jpg') || clean.endsWith('.jpeg')) return 'image/jpeg';
      if (clean.endsWith('.gif')) return 'image/gif';
      return 'image/png';
    }

    function applyFaviconLink(url) {
      if (!url || url === currentFaviconUrl) return;
      currentFaviconUrl = url;

      document.querySelectorAll("link[rel~='icon']").forEach((el) => el.remove());

      const link = document.createElement('link');
      link.rel = 'icon';
      link.type = detectIconType(url);
      link.href = url;
      document.head.appendChild(link);
    }

    function canLoadImage(url) {
      return new Promise((resolve) => {
        if (!url) {
          resolve(false);
          return;
        }
        if (url === defaultIcon) {
          resolve(true);
          return;
        }

        const img = new Image();
        let settled = false;
        const finish = (ok) => {
          if (settled) return;
          settled = true;
          clearTimeout(timer);
          img.onload = null;
          img.onerror = null;
          resolve(ok);
        };

        const timer = setTimeout(() => finish(false), IMAGE_TIMEOUT_MS);
        img.onload = () => finish(img.naturalWidth > 0);
        img.onerror = () => finish(false);
        img.src = url;
      });
    }

    function resolveAssetUrl(assetId, appId) {
      if (!assetId) return null;

      if (assetId.startsWith('mp:external/')) {
        return `https://media.discordapp.net/external/${assetId.replace(/^mp:external\//, '')}`;
      }
      if (assetId.startsWith('external/')) {
        return `https://media.discordapp.net/external/${assetId.replace(/^external\//, '')}`;
      }
      if (assetId.startsWith('mp:')) {
        return `https://media.discordapp.net/${assetId.replace(/^mp:\/?/, '')}`;
      }
      if (assetId.startsWith('spotify:')) {
        return `https://i.scdn.co/image/${assetId.replace('spotify:', '')}`;
      }
      if (assetId.startsWith('http://') || assetId.startsWith('https://')) {
        return assetId;
      }
      if (appId) {
        return `https://cdn.discordapp.com/app-assets/${appId}/${assetId}.png?size=128`;
      }
      return null;
    }

    function getDirectExternalFallbackUrl(raw) {
      if (!raw) return null;
      const match = raw.match(/\/https?\/(.+)$/);
      if (!match) return null;
      const protocol = raw.includes('/https/') ? 'https' : 'http';
      return `${protocol}://${match[1].replace(/%40/g, '@')}`;
    }

    function collectCandidateIcons(data) {
      const candidates = [];
      const pushUnique = (url) => {
        if (url && !candidates.includes(url)) {
          candidates.push(url);
        }
      };

      const user = data?.discord_user;
      const activities = data?.activities || [];

      const activeGame = activities.find(
        (a) =>
          (a.type === 0 || a.type === 1 || a.type === 2 || a.type === 3 || a.type === 5) &&
          (a.assets?.large_image || a.assets?.small_image),
      );

      if (activeGame) {
        const rawAsset = activeGame.assets?.large_image || activeGame.assets?.small_image;
        pushUnique(resolveAssetUrl(rawAsset, activeGame.application_id));
        pushUnique(getDirectExternalFallbackUrl(rawAsset));
      }

      if (data?.listening_to_spotify && data?.spotify?.album_art_url) {
        pushUnique(data.spotify.album_art_url);
      }

      if (user?.id && user?.avatar) {
        // Request static PNG frame so browsers reliably render animated avatars in tabs
        pushUnique(`https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128`);
      }

      pushUnique(defaultIcon);
      return candidates;
    }

    async function updateIconFromPresence(data) {
      if (!data) return;
      const seq = ++updateSeq;
      const candidates = collectCandidateIcons(data);

      for (const candidate of candidates) {
        if (seq !== updateSeq) return;
        if (candidate === currentFaviconUrl) return;

        const loaded = await canLoadImage(candidate);
        if (seq !== updateSeq) return;
        if (loaded) {
          applyFaviconLink(candidate);
          return;
        }
      }

      if (seq === updateSeq) {
        applyFaviconLink(defaultIcon);
      }
    }

    fetch(LANYARD_REST)
      .then((res) => (res.ok ? res.json() : null))
      .then((json) => {
        if (json && json.success && json.data) {
          updateIconFromPresence(json.data);
        }
      })
      .catch(() => {});

    function connect() {
      clearTimeout(reconnectTimer);
      try {
        socket = new WebSocket(LANYARD_WS);

        socket.onmessage = (event) => {
          try {
            const { op, d, t } = JSON.parse(event.data);

            if (op === 1) {
              const interval = d.heartbeat_interval || 30000;
              clearInterval(heartbeatTimer);
              heartbeatTimer = setInterval(() => {
                if (socket && socket.readyState === WebSocket.OPEN) {
                  socket.send(JSON.stringify({ op: 3 }));
                }
              }, interval);

              socket.send(JSON.stringify({ op: 2, d: { subscribe_to_id: discordId } }));
            }

            if (op === 0 && (t === 'INIT_STATE' || t === 'PRESENCE_UPDATE')) {
              updateIconFromPresence(d);
            }
          } catch (_) {}
        };

        socket.onclose = () => {
          clearInterval(heartbeatTimer);
          reconnectTimer = setTimeout(connect, 5000);
        };

        socket.onerror = () => {
          if (socket) socket.close();
        };
      } catch (_) {
        reconnectTimer = setTimeout(connect, 5000);
      }
    }

    connect();

    document.addEventListener(
      'astro:before-swap',
      () => {
        clearInterval(heartbeatTimer);
        clearTimeout(reconnectTimer);
        if (socket) socket.close();
      },
      { once: true },
    );
  })();
</script>
