---
interface Props {
  discordId: string;
  defaultIcon?: string;
}

const { discordId, defaultIcon = '/favicon.svg' } = Astro.props;
---

<script is:inline define:vars={{ discordId, defaultIcon }}>
  (() => {
    if (!discordId) return;

    const LANYARD_WS = 'wss://api.lanyard.rest/socket';
    const LANYARD_REST = `https://api.lanyard.rest/v1/users/${discordId}`;
    let currentFaviconUrl = '';
    let heartbeatTimer = null;
    let socket = null;
    let reconnectTimer = null;

    // 1. Динамическая замена <link rel="icon"> в <head>
    function setFavicon(url) {
      if (!url || url === currentFaviconUrl) return;
      currentFaviconUrl = url;

      // Удаляем старые теги иконки во избежание конфликтов и браузерного кэширования
      const oldLinks = document.querySelectorAll("link[rel*='icon']");
      oldLinks.forEach((el) => el.remove());

      const link = document.createElement('link');
      link.rel = 'icon';
      link.type = url.endsWith('.svg') ? 'image/svg+xml' : 'image/png';
      link.href = url;

      // При ошибке загрузки изображения (например, битый ассет) откатываемся на дефолт
      link.onerror = () => {
        if (link.href !== defaultIcon) {
          link.href = defaultIcon;
        }
      };

      document.head.appendChild(link);
    }

    // 2. Преобразование ассетов активности в валидный URL
    function resolveAssetUrl(assetId, appId) {
      if (!assetId) return null;

      if (assetId.startsWith('mp:external/')) {
        return `https://media.discordapp.net/external/${assetId.replace(/^mp:external\//, '')}`;
      }
      if (assetId.startsWith('external/')) {
        return `https://media.discordapp.net/external/${assetId.replace(/^external\//, '')}`;
      }
      if (assetId.startsWith('spotify:')) {
        return `https://i.scdn.co/image/${assetId.replace('spotify:', '')}`;
      }
      if (assetId.startsWith('http://') || assetId.startsWith('https://')) {
        return assetId;
      }
      if (appId) {
        return `https://cdn.discordapp.com/app-assets/${appId}/${assetId}.png?size=64`;
      }
      return null;
    }

    // 3. Выбор иконки на основе Lanyard Presence:
    //    Активность (игра/IDE) -> Spotify -> Аватарка Discord -> Дефолтная иконка
    function updateIconFromPresence(data) {
      if (!data) return;

      const user = data.discord_user;
      const activities = data.activities || [];

      // Приоритет 1: Активность в игре, стриме или IDE (type 0: Playing, 1: Streaming, 2: Listening, 3: Watching, 5: Competing)
      const activeGame = activities.find(
        (a) =>
          (a.type === 0 || a.type === 1 || a.type === 2 || a.type === 3 || a.type === 5) &&
          (a.assets?.large_image || a.assets?.small_image)
      );

      if (activeGame) {
        const rawAsset = activeGame.assets?.large_image || activeGame.assets?.small_image;
        const iconUrl = resolveAssetUrl(rawAsset, activeGame.application_id);
        if (iconUrl) {
          setFavicon(iconUrl);
          return;
        }
      }

      // Приоритет 2: Spotify трек
      if (data.listening_to_spotify && data.spotify?.album_art_url) {
        setFavicon(data.spotify.album_art_url);
        return;
      }

      // Приоритет 3: Откат на Discord аватарку пользователя
      if (user?.id && user?.avatar) {
        const isGif = user.avatar.startsWith('a_');
        const ext = isGif ? 'gif' : 'png';
        const avatarUrl = `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.${ext}?size=64`;
        setFavicon(avatarUrl);
        return;
      }

      // Приоритет 4: Дефолтная иконка сайта
      setFavicon(defaultIcon);
    }

    // 4. Мгновенная инициализация через REST API (до открытия WebSocket)
    fetch(LANYARD_REST)
      .then((res) => (res.ok ? res.json() : null))
      .then((json) => {
        if (json && json.success && json.data) {
          updateIconFromPresence(json.data);
        }
      })
      .catch(() => {});

    // 5. Постоянное real-time соединение через Lanyard WebSocket Gateway
    function connect() {
      clearTimeout(reconnectTimer);
      try {
        socket = new WebSocket(LANYARD_WS);

        socket.onmessage = (event) => {
          try {
            const { op, d, t } = JSON.parse(event.data);

            // Opcode 1: HELLO от сервера -> запуск Heartbeat и подписка
            if (op === 1) {
              const interval = d.heartbeat_interval || 30000;
              clearInterval(heartbeatTimer);
              heartbeatTimer = setInterval(() => {
                if (socket && socket.readyState === WebSocket.OPEN) {
                  socket.send(JSON.stringify({ op: 3 }));
                }
              }, interval);

              // Opcode 2: Подписка на пользователя
              socket.send(JSON.stringify({ op: 2, d: { subscribe_to_id: discordId } }));
            }

            // Opcode 0: Обновление статуса (INIT_STATE или PRESENCE_UPDATE)
            if (op === 0 && (t === 'INIT_STATE' || t === 'PRESENCE_UPDATE')) {
              updateIconFromPresence(d);
            }
          } catch (_) {}
        };

        socket.onclose = () => {
          clearInterval(heartbeatTimer);
          reconnectTimer = setTimeout(connect, 5000);
        };

        socket.onerror = () => {
          if (socket) socket.close();
        };
      } catch (_) {
        reconnectTimer = setTimeout(connect, 5000);
      }
    }

    connect();

    // Очистка при смене страницы в Astro View Transitions
    document.addEventListener(
      'astro:before-swap',
      () => {
        clearInterval(heartbeatTimer);
        clearTimeout(reconnectTimer);
        if (socket) socket.close();
      },
      { once: true }
    );
  })();
</script>