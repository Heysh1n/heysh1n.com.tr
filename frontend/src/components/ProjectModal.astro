---
import { renderProjectContent, renderMarkdown } from '../utils/markdown';
import 'katex/dist/katex.min.css';

interface Props {
  id: string;
  title: string;
  description?: string | null;
  markdownContent?: unknown;
  contentHtml?: string | null;
  tags?: string[] | string | null;
  status?: string | null;
  statusCode?: string | null;
  ctaUrl?: string | null;
  ctaLabel?: string | null;
  githubUrl?: string | null;
  demoUrl?: string | null;
}

const {
  id,
  title,
  description,
  markdownContent,
  contentHtml,
  tags,
  status,
  statusCode,
  ctaUrl,
  ctaLabel,
  githubUrl,
  demoUrl,
} = Astro.props;

// Контент рендерится строго на этапе Astro SSG сборки (Zero Client JS)
const renderedHtml = markdownContent
  ? renderProjectContent(markdownContent)
  : (contentHtml || '');

const tagsList: string[] = Array.isArray(tags)
  ? tags
  : typeof tags === 'string'
    ? tags.split(',').map((t) => t.trim()).filter(Boolean)
    : [];

const resolvedGithub = githubUrl || null;
const resolvedCtaUrl = ctaUrl || resolvedGithub || demoUrl || null;
const resolvedCtaLabel =
  ctaLabel ||
  (ctaUrl
    ? 'Перейти к проекту'
    : resolvedGithub
      ? 'Перейти на GitHub'
      : demoUrl
        ? 'Открыть демо'
        : 'Перейти к проекту');
---

<dialog
  id={id}
  class="modal glassmorphism bg-[#0f0717]/90 backdrop-blur-xl border border-white/10 shadow-2xl rounded-3xl"
  aria-labelledby={`${id}-title`}
  closedby="any"
>
  <button
    type="button"
    class="modal_close absolute top-5 right-5 z-20 bg-white/5 hover:bg-white/10 rounded-full p-2 text-zinc-400 hover:text-white transition-colors cursor-pointer"
    data-modal-close
    aria-label={`Закрыть ${title}`}
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="modal_inner">
    <div class="modal_header pr-10">
      <div class="modal_header_info">
        <h2 id={`${id}-title`} class="modal_title">{title}</h2>
        <div class="modal_meta_row">
          {status && (
            <span class="project_status" data-status={statusCode || ''}>
              {status}
            </span>
          )}
          {tagsList.length > 0 && (
            <div class="modal_tags">
              {tagsList.map((tag) => (
                <span class="modal_tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    {description && <p class="modal_description">{description}</p>}

    {renderedHtml && (
      <div class="modal_body markdown-body text-zinc-300 leading-relaxed space-y-4" set:html={renderedHtml} />
    )}

    <slot />

    {(resolvedCtaUrl || resolvedGithub || demoUrl) && (
      <div class="modal_footer">
        {resolvedCtaUrl && (
          <a
            href={resolvedCtaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="modal_cta_primary w-full bg-purple-600 hover:bg-purple-500 text-white font-medium py-3 px-6 rounded-xl transition-all shadow-[0_0_15px_rgba(168,85,247,0.4)] flex items-center justify-center gap-2"
          >
            <span>{resolvedCtaLabel}</span>
            <span class="cta_arrow" aria-hidden="true">↗</span>
          </a>
        )}
        {resolvedGithub && resolvedCtaUrl !== resolvedGithub && (
          <a
            href={resolvedGithub}
            target="_blank"
            rel="noopener noreferrer"
            class="modal_cta_secondary"
          >
            <span>GitHub</span>
            <span class="cta_arrow" aria-hidden="true">→</span>
          </a>
        )}
        {demoUrl && resolvedCtaUrl !== demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="modal_cta_secondary"
          >
            <span>Демо</span>
            <span class="cta_arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    )}
  </div>
</dialog>

<style>
  /* ── Native <dialog> Modal styling with Glassmorphism ── */
  dialog.modal {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(92vw, 720px);
    max-height: min(85vh, 85dvh);
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    background: rgba(15, 7, 23, 0.9);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    color: #e4e4e7;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 40px rgba(168, 85, 247, 0.18);
    overflow: hidden;
    outline: none;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                overlay 0.2s allow-discrete,
                display 0.2s allow-discrete;
  }

  /* MANDATORY modern web guidance: Contain scroll chaining inside modal */
  dialog.modal:modal {
    overscroll-behavior: contain;
  }

  dialog.modal[open] {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    dialog.modal[open] {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  /* ── Darkened backdrop with blur & scroll containment ── */
  dialog.modal::backdrop {
    background: rgba(8, 2, 14, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: hidden;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 0.2s ease,
                overlay 0.2s allow-discrete,
                display 0.2s allow-discrete;
  }

  dialog.modal[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    dialog.modal[open]::backdrop {
      opacity: 0;
    }
  }

  .modal_inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    overflow-y: auto;
    max-height: min(85vh, 85dvh);
    box-sizing: border-box;
    scrollbar-gutter: stable;
  }

  .modal_header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1rem;
  }

  .modal_header_info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .modal_title {
    font-size: clamp(1.3rem, 1.15rem + 0.8vw, 1.65rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    word-break: break-word;
  }

  .modal_meta_row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .modal_tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .modal_tag {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(196, 140, 255, 0.2);
    color: #e9d5ff;
    white-space: nowrap;
  }

  .modal_description {
    color: #a1a1aa;
    font-size: clamp(0.9rem, 0.85rem + 0.25vw, 0.98rem);
    line-height: 1.6;
    margin: 0;
  }

  .modal_close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 20;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #a1a1aa;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .modal_close:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: scale(1.05);
  }

  .modal_close:active {
    transform: scale(0.95);
  }

  .modal_body {
    font-size: clamp(0.88rem, 0.84rem + 0.2vw, 0.96rem);
    line-height: 1.7;
    color: #d4d4d8;
  }

  .modal_footer {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 0.25rem;
  }

  .modal_cta_primary {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: #9333ea;
    border: 1px solid rgba(216, 180, 254, 0.35);
    border-radius: 12px;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s ease,
                background 0.2s ease,
                box-shadow 0.2s ease;
  }

  .modal_cta_primary:hover {
    transform: translateY(-1px);
    background: #a855f7;
    border-color: rgba(233, 213, 255, 0.5);
    box-shadow: 0 0 22px rgba(168, 85, 247, 0.55);
  }

  .modal_cta_primary:active {
    transform: translateY(0);
  }

  .modal_cta_secondary {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.68rem 1.15rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #d4d4d8;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .modal_cta_secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .cta_arrow {
    font-size: 1.05rem;
    line-height: 1;
    color: inherit;
    text-shadow: none;
    transition: transform 0.18s ease;
  }

  .modal_cta_primary span {
    color: #ffffff;
    font-size: inherit;
    text-shadow: none;
  }

  .modal_cta_secondary span {
    color: inherit;
    font-size: inherit;
    text-shadow: none;
  }

  .modal_cta_primary:hover .cta_arrow,
  .modal_cta_secondary:hover .cta_arrow {
    transform: translate(2px, -2px);
  }
</style>

<script>
  // Единое глобальное делегирование событий для модальных окон (native <dialog>)
  const setupModalDelegation = () => {
    if ((window as any).__projectModalHandlerAttached) return;
    (window as any).__projectModalHandlerAttached = true;

    // 1. Открытие модалок по клику на любой триггер с [data-modal-target]
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const openTrigger = target.closest<HTMLElement>('[data-modal-target]');
      if (openTrigger) {
        const dialogId = openTrigger.dataset.modalTarget;
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          if (dialog && typeof dialog.showModal === 'function') {
            dialog.showModal();
          }
        }
        return;
      }

      // 2. Закрытие по клику на кнопку [data-modal-close]
      const closeTrigger = target.closest<HTMLElement>('[data-modal-close]');
      if (closeTrigger) {
        const dialog = closeTrigger.closest('dialog');
        dialog?.close();
        return;
      }

      // 3. Fallback закрытия по клику на backdrop для браузеров без поддержки closedby="any"
      if (!('closedBy' in HTMLDialogElement.prototype) && target.tagName === 'DIALOG') {
        const dialog = target as HTMLDialogElement;
        if (dialog.open) {
          const rect = dialog.getBoundingClientRect();
          const clickedInside =
            rect.top <= event.clientY &&
            event.clientY <= rect.top + rect.height &&
            rect.left <= event.clientX &&
            event.clientX <= rect.left + rect.width;

          if (!clickedInside) {
            dialog.close();
          }
        }
      }
    });
  };

  setupModalDelegation();
  document.addEventListener('astro:page-load', setupModalDelegation);
</script>
