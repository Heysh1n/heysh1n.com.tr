---
interface Props {
  name: string
  role: string
}

const { name, role } = Astro.props
---

<button
  type="button"
  data-modal-target="modal-hero"
  aria-controls="modal-hero"
  aria-expanded="false"
  aria-label={`Open ${name} identity details`}
  class="bento-card group col-span-12 md:col-span-8 rounded-xl border border-white/5 bg-black/40 p-6 text-left opacity-0 translate-y-8 backdrop-blur-xl transition-all duration-300 hover:scale-[1.01] hover:border-purple-500/50 hover:bg-black/60 hover:shadow-[0_0_40px_rgba(168,85,247,0.15)] focus:outline-none"
>
  <div class="flex h-full items-end justify-between gap-4">
    <div>
      <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.3em] text-purple-400/80">Workspace</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-5xl group-hover:animate-pulse group-hover:text-purple-400 transition-colors drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">{name}</h1>
    </div>
    <p class="text-right text-sm font-medium text-neutral-300 sm:text-base">{role}</p>
  </div>
</button>
