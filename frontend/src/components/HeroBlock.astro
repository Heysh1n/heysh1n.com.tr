---
interface Props {
  name: string;
  role: string;
}

const { name, role } = Astro.props;
---

<button
  type="button"
  data-modal-target="modal-hero"
  aria-controls="modal-hero"
  aria-expanded="false"
  aria-label={`Open ${name} profile details`}
  class="glassmorphism project_card col-span-12 md:col-span-8"
>
  <div class="flex h-full w-full items-end justify-between gap-4">
    <div>
      <p class="hero_title">hero.md</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">{name}</h1>
    </div>
    <p class="text-right text-sm font-medium text-[#d8b4fe] sm:text-base">{role}</p>
  </div>
</button>
