---
interface Props {
  name: string;
  role: string;
  description: string;
  techCount: number;
}

const { name, role, description, techCount } = Astro.props;
---

<article class="module module-hero">
  <header class="module-head">
    <span class="module-label">hero.md</span>
    <span class="module-meta">heysh1n.com.tr</span>
  </header>

  <div class="module-body">
    <div class="hero-identity">
      <h1 class="hero-name">{name}</h1>
      <p class="hero-role">{role}</p>
    </div>
    <p class="hero-desc">{description}</p>
  </div>

  <footer class="module-foot">
    <button
      type="button"
      class="btn-surface hero-stack-trigger"
      data-modal-target="modal-stack"
      aria-controls="modal-stack"
    >
      <span>stack.yml</span>
      <span class="hero-stack-meta">
        <span>{techCount}</span>
        <span aria-hidden="true">↗</span>
      </span>
    </button>
  </footer>
</article>
