---
interface Props {
  stackSummary: string
}

const { stackSummary } = Astro.props
---

<button
  type="button"
  data-modal-target="modal-stack"
  aria-controls="modal-stack"
  aria-expanded="false"
  aria-label="Open main backend stack details"
  class="bento-card group col-span-12 md:col-span-8 rounded-xl border border-neutral-800 bg-neutral-900/50 p-5 text-left opacity-0 translate-y-8 backdrop-blur-md transition-all hover:scale-[1.02] hover:border-neutral-600 hover:shadow-[0_0_32px_rgba(88,28,135,0.18)] focus:outline-none focus:ring-2 focus:ring-purple-900/50"
>
  <p class="text-xs font-medium uppercase tracking-[0.24em] text-neutral-500">Main Stack</p>
  <h2 class="mt-8 text-2xl font-semibold tracking-tight text-white">{stackSummary}</h2>
  <p class="mt-3 text-sm leading-6 text-neutral-400">Shell-first backend workflow.</p>
</button>
