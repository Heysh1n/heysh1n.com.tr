---
interface Props {
  stackSummary: string;
}

const { stackSummary } = Astro.props;
---

<button
  type="button"
  data-modal-target="modal-stack"
  aria-controls="modal-stack"
  aria-expanded="false"
  aria-label="Open stack details"
  class="glassmorphism project_card col-span-12 md:col-span-8"
>
  <p class="hero_title">stack.yml</p>
  <h2 class="project_title mt-4">{stackSummary}</h2>
  <p class="project_description">Linux, backend, and networking tools.</p>
</button>
