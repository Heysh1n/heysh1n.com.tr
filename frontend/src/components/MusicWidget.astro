---
interface Props {
  lastFmUser: string;
}

const { lastFmUser } = Astro.props;
const normalizedLastFmUser = lastFmUser.trim();
const title = 'Spotify / Music';
const description = normalizedLastFmUser
  ? `Last.fm activity for ${normalizedLastFmUser}.`
  : 'Music playback status.';
---

<button
  type="button"
  data-modal-target="modal-music"
  aria-controls="modal-music"
  aria-expanded="false"
  aria-label="Open music widget details"
  class="glassmorphism project_card col-span-12 md:col-span-4"
>
  <p class="hero_title">player.sh</p>
  <h2 class="project_title mt-4">{title}</h2>
  <p class="project_description">{description}</p>
</button>
