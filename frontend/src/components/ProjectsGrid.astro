---
type ProjectStatus = 'active' | 'in_progress' | 'archived';

interface ProjectCard {
  description: string;
  dialogId: string;
  status?: ProjectStatus | null;
  title: string;
  tone?: 'purple' | 'red';
}

interface Props {
  projectCards: ProjectCard[];
  statusLabels: Record<ProjectStatus, string>;
}

const { projectCards, statusLabels } = Astro.props;
---

{projectCards.map((project) => (
  <button
    type="button"
    data-modal-target={project.dialogId}
    aria-controls={project.dialogId}
    aria-expanded="false"
    aria-label={`Open ${project.title} project details`}
    class="glassmorphism project_card col-span-6 md:col-span-4"
  >
    <div class="project_card_body">
      <div class="project_card_header">
        <h2 class="project_title">{project.title}</h2>
      </div>
      <p class="project_description">{project.description}</p>
    </div>
    {project.status && (
      <div class="project_card_footer">
        <span class="project_status" data-status={project.status}>
          {statusLabels[project.status]}
        </span>
      </div>
    )}
  </button>
))}
