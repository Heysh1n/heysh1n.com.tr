---
type ProjectStatus = 'active' | 'in_progress' | 'archived'
type ProjectTone = 'purple' | 'red'

interface ProjectCard {
  description: string
  dialogId: string
  status?: ProjectStatus | null
  title: string
  tone: ProjectTone
}

interface Props {
  projectCards: ProjectCard[]
  statusLabels: Record<ProjectStatus, string>
}

const { projectCards, statusLabels } = Astro.props

const projectButtonClass = (tone: ProjectTone) =>
  [
    'bento-card group col-span-6 md:col-span-4 rounded-xl border border-white/5 bg-black/40 p-6 text-left opacity-0 translate-y-8 backdrop-blur-xl transition-all duration-300 hover:scale-[1.02] hover:bg-black/60 focus:outline-none',
    tone === 'purple'
      ? 'hover:border-purple-500/40 hover:shadow-[0_0_30px_rgba(168,85,247,0.1)]'
      : 'hover:border-red-500/40 hover:shadow-[0_0_30px_rgba(239,68,68,0.1)]',
  ].join(' ')
---

{projectCards.map((project) => (
  <button
    type="button"
    data-modal-target={project.dialogId}
    aria-controls={project.dialogId}
    aria-expanded="false"
    aria-label={`Open ${project.title} project details`}
    class={projectButtonClass(project.tone)}
  >
    <p class="text-xs font-medium uppercase tracking-[0.24em] text-neutral-500">
      {project.status ? statusLabels[project.status] : 'Project'}
    </p>
    <h2 class="mt-8 text-xl font-semibold tracking-tight text-white">{project.title}</h2>
    <p class="mt-3 text-sm leading-6 text-neutral-400">{project.description}</p>
  </button>
))}
