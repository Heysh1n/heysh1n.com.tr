---
import Layout from '../layouts/Layout.astro';
import MusicWidgetIsland from '../components/MusicWidgetIsland';
import DiscordProfileIsland from '../components/DiscordProfileIsland';
import ProjectModal from '../components/ProjectModal.astro';
import { renderProjectContent } from '../utils/markdown';

type PayloadListResponse<T> = {
  docs?: T[];
};

type HomePageSocial = {
  id?: string;
  platform: string;
  url: string;
  enabled?: boolean | null;
};

type HomePageGlobal = {
  name?: string | null;
  role?: string | null;
  description?: string | null;
  music_provider?: 'ytmusic' | 'lastfm' | null;
  ytmusic_url?: string | null;
  lastfm_user?: string | null;
  discord_id?: string | null;
  discord_username?: string | null;
  discord_tag?: string | null;
  socials?: HomePageSocial[] | null;
};

type ProjectStatus = 'active' | 'in_progress' | 'archived';
type TechnologyCategory = 'os_tools' | 'languages' | 'networks' | 'game_servers';

type RichTextNode = {
  children?: RichTextNode[];
  fields?: {
    url?: string;
  };
  format?: number | string;
  listType?: string;
  tag?: string;
  text?: string;
  type?: string;
  url?: string;
};

type RichTextContent = {
  root?: RichTextNode;
};

type Project = {
  id?: number | string;
  title: string;
  slug: string;
  description: string;
  detailedContent?: RichTextContent | null;
  status?: ProjectStatus | null;
  githubLink?: string | null;
};

type Technology = {
  id?: number | string;
  name: string;
  category?: TechnologyCategory | null;
};
const isProd = import.meta.env.PROD;
const rawBackendUrl =
  import.meta.env.PUBLIC_BACKEND_URL ||
  import.meta.env.BACKEND_URL ||
  (isProd ? '' : 'http://localhost:3000');

if (!rawBackendUrl) {
  if (isProd) {
    throw new Error(
      '❌ [SSG Build Error] PUBLIC_BACKEND_URL is not configured for production build! Please add PUBLIC_BACKEND_URL in Cloudflare Dashboard: Settings -> Build -> Build variables and secrets.'
    );
  } else {
    console.warn('⚠️ [Dev Warning] PUBLIC_BACKEND_URL is not set, falling back to http://localhost:3000');
  }
}

const backendUrl = rawBackendUrl.replace(/\/+$/, '');
console.log(`[Payload SSG] Fetching data for static build from: ${backendUrl}`);

const homePageEndpoint = `${backendUrl}/api/globals/home-page`;
const projectsEndpoint = `${backendUrl}/api/projects`;
const technologiesEndpoint = `${backendUrl}/api/technologies`;
// Render (free tier) + Neon cold-start can take up to 45 seconds during production build
const payloadFetchTimeoutMs = isProd ? 45000 : 10000;

const categoryLabels: Record<TechnologyCategory, string> = {
  os_tools: 'OS & Tools',
  languages: 'Languages',
  networks: 'Networks',
  game_servers: 'Game Servers',
};

const statusLabels: Record<ProjectStatus, string> = {
  active: 'Active',
  in_progress: 'In Progress',
  archived: 'Archived',
};

const createRichText = (paragraphs: string[]): RichTextContent => ({
  root: {
    type: 'root',
    children: paragraphs.map((text) => ({
      type: 'paragraph',
      children: [{ type: 'text', text }],
    })),
  },
});

const fallbackProjects: Project[] = [
  {
    title: 'SFC.py',
    slug: 'sfc-py',
    description: 'Smart File Collector.',
    status: 'active',
    detailedContent: createRichText([
      'CLI/TUI utility on Python stdlib for parsing project structure.',
      'Features include tree architecture parsing, TUI mode, targeted file picking, and monolithic context generation for LLM workflows.',
      '> sfc tree -l 4',
      '> sfc pick "*.py"',
    ]),
  },
  {
    title: 'AFS Project',
    slug: 'afs-project',
    description: 'Arduino/ESP32 Face Detection.',
    status: 'in_progress',
    detailedContent: createRichText([
      'Hardware-software security and logging complex.',
      'Uses Arduino Uno, ESP32, PIR sensors, face detection integration, metrics collection, and physical presence triggers.',
    ]),
  },
  {
    title: 'Minecraft Cores',
    slug: 'minecraft-cores',
    description: 'Nukkit / Endstone Java Plugins.',
    status: 'active',
    detailedContent: createRichText([
      'Plugin-side server work around command handling, event listeners, permissions, scheduled tasks, and performance-conscious gameplay systems.',
    ]),
  },
  {
    title: 'Proxies',
    slug: 'proxies',
    description: 'VLESS / Hysteria 2 Configs.',
    status: 'active',
    detailedContent: createRichText([
      'Network tunneling and proxy configuration practice with TLS-aware routing, service files, port hygiene, client profiles, and failure-mode debugging.',
    ]),
  },
];

const fallbackTechnologies: Technology[] = [
  { name: 'Debian 13', category: 'os_tools' },
  { name: 'Zsh', category: 'os_tools' },
  { name: 'Termius', category: 'os_tools' },
  { name: 'Python', category: 'languages' },
  { name: 'TypeScript', category: 'languages' },
  { name: 'Java', category: 'languages' },
  { name: 'VLESS Protocol', category: 'networks' },
  { name: 'Hysteria 2', category: 'networks' },
  { name: 'Nukkit Core', category: 'game_servers' },
  { name: 'Endstone', category: 'game_servers' },
];

const fallbackHomePage: HomePageGlobal = {
  name: 'Heysh1n',
  role: 'Backend Engineer',
  description:
    'Anonymous backend and systems persona focused on practical tooling, resilient server workflows, Linux-first environments, and hardware-adjacent experiments.',
  lastfm_user: '',
  discord_id: '995737379417640961',
  discord_username: 'heysh1n',
  discord_tag: 'HEYSH1N',
};

const fetchPayloadGlobal = async <T,>(url: string): Promise<T | null> => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), payloadFetchTimeoutMs);

  try {
    const response = await fetch(url, {
      method: 'GET',
      signal: controller.signal,
    });

    if (!response.ok) {
      throw new Error(`Payload responded with ${response.status}`);
    }

    const payload = (await response.json()) as unknown;

    if (!payload || typeof payload !== 'object') {
      throw new Error('Payload returned an invalid global object');
    }

    return payload as T;
  } catch (error) {
    const message =
      error instanceof Error && error.name === 'AbortError'
        ? `Payload request timed out after ${payloadFetchTimeoutMs}ms`
        : error instanceof Error
          ? error.message
          : String(error);
    console.warn(`Unable to fetch Payload global from ${url}: ${message}`);
    return null;
  } finally {
    clearTimeout(timeout);
  }
};

const fetchPayloadDocs = async <T,>(url: string): Promise<T[]> => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), payloadFetchTimeoutMs);

  try {
    const response = await fetch(url, { signal: controller.signal });

    if (!response.ok) {
      throw new Error(`Payload responded with ${response.status}`);
    }

    const payload = (await response.json()) as PayloadListResponse<T>;
    return Array.isArray(payload.docs) ? payload.docs : [];
  } catch (error) {
    const message =
      error instanceof Error && error.name === 'AbortError'
        ? `Payload request timed out after ${payloadFetchTimeoutMs}ms`
        : error instanceof Error
          ? error.message
          : String(error);
    console.warn(`Unable to fetch Payload data from ${url}: ${message}`);
    return [];
  } finally {
    clearTimeout(timeout);
  }
};

const escapeHtml = (value: string): string =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');

const withTextFormat = (text: string, format?: number | string): string => {
  if (typeof format !== 'number') {
    return text;
  }

  let formatted = text;

  if (format & 16) formatted = `<code>${formatted}</code>`;
  if (format & 8) formatted = `<u>${formatted}</u>`;
  if (format & 4) formatted = `<s>${formatted}</s>`;
  if (format & 2) formatted = `<em>${formatted}</em>`;
  if (format & 1) formatted = `<strong>${formatted}</strong>`;

  return formatted;
};

const renderChildren = (children: RichTextNode[] = []): string => children.map(renderRichTextNode).join('');

const renderRichTextNode = (node: RichTextNode): string => {
  const children = renderChildren(node.children);

  switch (node.type) {
    case 'root':
      return children;
    case 'text':
      return withTextFormat(escapeHtml(node.text ?? ''), node.format);
    case 'linebreak':
      return '<br />';
    case 'heading': {
      const tag = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'].includes(node.tag ?? '') ? node.tag : 'h3';
      return `<${tag}>${children}</${tag}>`;
    }
    case 'paragraph':
      return `<p>${children}</p>`;
    case 'quote':
      return `<blockquote>${children}</blockquote>`;
    case 'list': {
      const tag = node.listType === 'number' ? 'ol' : 'ul';
      return `<${tag}>${children}</${tag}>`;
    }
    case 'listitem':
      return `<li>${children}</li>`;
    case 'link':
    case 'autolink': {
      const href = escapeHtml(node.fields?.url ?? node.url ?? '#');
      return `<a href="${href}" target="_blank" rel="noreferrer">${children || href}</a>`;
    }
    case 'code':
      return `<pre><code>${children || escapeHtml(node.text ?? '')}</code></pre>`;
    default:
      return children || escapeHtml(node.text ?? '');
  }
};

const renderRichText = (content?: RichTextContent | null): string => {
  const html = content?.root ? renderRichTextNode(content.root) : '';

  return html.trim() || '<p>No detailed content has been published yet.</p>';
};

const sanitizeId = (value: string): string =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9-_]+/g, '-')
    .replace(/^-+|-+$/g, '');

const textOrFallback = (value: string | null | undefined, fallback: string): string => {
  const trimmed = value?.trim();
  return trimmed || fallback;
};

const [homePage, fetchedProjects, fetchedTechnologies] = await Promise.all([
  fetchPayloadGlobal<HomePageGlobal>(homePageEndpoint),
  fetchPayloadDocs<Project>(projectsEndpoint),
  fetchPayloadDocs<Technology>(technologiesEndpoint),
]);

const heroName = textOrFallback(homePage?.name, fallbackHomePage.name ?? 'Heysh1n');
const heroRole = textOrFallback(homePage?.role, fallbackHomePage.role ?? 'Backend Engineer');
const heroDesc = textOrFallback(
  homePage?.description,
  fallbackHomePage.description ??
    'Anonymous backend and systems persona focused on practical tooling, resilient server workflows, Linux-first environments, and hardware-adjacent experiments.',
);
const lastFmUser = textOrFallback(homePage?.lastfm_user, fallbackHomePage.lastfm_user ?? '');

const projects = fetchedProjects.length > 0 ? fetchedProjects : fallbackProjects;
const technologies = fetchedTechnologies.length > 0 ? fetchedTechnologies : fallbackTechnologies;

const projectCards = projects.map((project, index) => ({
  ...project,
  contentHtml: renderProjectContent(project.detailedContent),
  dialogId: `modal-project-${sanitizeId(project.slug || String(project.id ?? index))}`,
  tone: index % 2 === 0 ? 'purple' : 'red',
}));

const stackGroups = (Object.keys(categoryLabels) as TechnologyCategory[]).map((category) => ({
  category,
  label: categoryLabels[category],
  names: technologies
    .filter((technology) => technology.category === category)
    .map((technology) => technology.name),
}));

const stackSummary =
  technologies
    .map((technology) => technology.name)
    .slice(0, 4)
    .join(', ') || 'Payload stack data';

const fallbackSocials: HomePageSocial[] = [

];

const enabledSocials = homePage?.socials?.filter((s) => s.enabled !== false);
const socials = enabledSocials && enabledSocials.length > 0 ? enabledSocials : fallbackSocials;

const lastFmApiKey = import.meta.env.PUBLIC_LASTFM_API_KEY || '42bf547ad2d7ae6d078dd9fee67571a3';
const musicProvider = homePage?.music_provider || 'ytmusic';
const ytmusicUrl = homePage?.ytmusic_url || null;
const discordId = textOrFallback(homePage?.discord_id, fallbackHomePage.discord_id ?? '995737379417640961');
const discordUsername = textOrFallback(homePage?.discord_username, fallbackHomePage.discord_username ?? 'heysh1n');
const discordTag = textOrFallback(homePage?.discord_tag, fallbackHomePage.discord_tag ?? 'HEYSH1N');

const getSocialMeta = (rawUrl: string, explicitPlatform?: string | null) => {
  let parsedUrl: URL | null = null;
  try {
    parsedUrl = new URL(rawUrl.startsWith('http') ? rawUrl : `https://${rawUrl}`);
  } catch {
    parsedUrl = null;
  }

  const hostname = parsedUrl ? parsedUrl.hostname.toLowerCase().replace(/^www\./, '') : '';
  const domain = hostname;

  let platform = (explicitPlatform || '').trim().toLowerCase();
  if (!platform && hostname) {
    if (hostname.includes('steampowered.com') || hostname.includes('steamcommunity.com')) {
      platform = 'steam';
    } else if (hostname === 't.me' || hostname.includes('telegram.')) {
      platform = 'telegram';
    } else if (hostname === 'x.com' || hostname.includes('twitter.')) {
      platform = 'x';
    } else if (hostname.includes('discord.')) {
      platform = 'discord';
    } else if (hostname.includes('youtube.') || hostname === 'youtu.be') {
      platform = 'youtube';
    } else {
      const parts = hostname.split('.');
      
      platform = parts.length > 1 ? parts[parts.length - 2] : parts[0];
    }
  }
  platform = platform || 'link';

  const iconUrl = `https://cdn.simpleicons.org/${encodeURIComponent(platform)}/white`;
  const fallbackFavicon = domain
    ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`
    : '/assets/svg/github.svg';

  const title = `${platform}.link`;

  const cleaned = parsedUrl ? parsedUrl.pathname.replace(/^[/@]+/, '').replace(/\/+$/, '') : '';
  const subText = cleaned || hostname || platform;

  return {
    platform,
    domain,
    title,
    subText,
    handle: subText,
    iconUrl,
    fallbackFavicon,
    url: parsedUrl ? parsedUrl.toString() : rawUrl,
  };
};
---
<Layout discordId={discordId}>
  <main class="w-full max-w-5xl mx-auto p-4 flex flex-col justify-center items-center">
    <section class="bento-container">
      <div class="hero_card glassmorphism h-full flex flex-col">
        <span class="hero_title">hero.md</span>
        <span class="hero_item">{heroName}</span>
        <span class="hero_item mb-4">{heroRole}</span>
        <button 
          type="button" 
          class="w-full text-center py-2 px-4 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 transition-colors text-sm text-purple-300 mt-4"
          data-modal-target="modal-stack"
        >
          [ Open stack.yml ]
        </button>
      </div>

      <div class="env_card glassmorphism">
        <DiscordProfileIsland
          client:load
          discordId={discordId}
          username={discordUsername}
          displayName={heroName}
          fallbackTag={discordTag}
        />
      </div>

      <div class="player_card glassmorphism">
        <div class="player_header">
          <span class="hero_title">player.sh</span>
        </div>
        <MusicWidgetIsland
          client:load
          discordId={discordId}
          username={lastFmUser}
          apiKey={lastFmApiKey}
          ytmusicUrl={ytmusicUrl}
          preferredProvider={musicProvider}
          backendUrl={backendUrl}
        />
      </div>

      {/* ── Project Cards (clickable → open modal) ── */}
      {projectCards.map((project) => (
        <button
          type="button"
          class="project_card glassmorphism"
          data-modal-target={project.dialogId}
          aria-label={`Open ${project.title} details`}
        >
          <span class="project_title">{project.title}</span>
          <p class="project_description">{project.description}</p>
          {project.status && (
            <span class="project_status" data-status={project.status}>
              {statusLabels[project.status]}
            </span>
          )}
        </button>
      ))}



      <hr class="social-divider" />

      <div class="socials-container">
        {socials.map((social) => {
          const meta = getSocialMeta(social.url, social.platform);
          return (
            <a
              class="social-card glassmorphism"
              href={meta.url}
              target="_blank"
              rel="noreferrer"
              title={meta.title}
            >
              <img
                src={meta.iconUrl}
                alt={meta.platform}
                class="social-icon"
                loading="lazy"
                onerror={`this.onerror=null; this.src='${meta.fallbackFavicon}';`}
              />
              <div class="social-info">
                <span class="social-title">{meta.title}</span>
                <span class="social-handle">{meta.handle}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>

  {/* ── Project Modals (Reusable <ProjectModal /> with native <dialog>) ── */}
  {projectCards.map((project) => (
    <ProjectModal
      id={project.dialogId}
      title={project.title}
      contentHtml={project.contentHtml}
      status={project.status ? statusLabels[project.status] : null}
      statusCode={project.status}
      githubLink={project.githubLink}
    />
  ))}

  {/* ── Stack Modal (Reusable <ProjectModal />) ── */}
  <ProjectModal id="modal-stack" title="Technology Stack">
    <div class="modal_body">
      {stackGroups.map((group) =>
        group.names.length > 0 && (
          <div class="stack_group">
            <h3 class="stack_group_label">{group.label}</h3>
            <ul class="stack_list">
              {group.names.map((name) => (
                <li class="stack_chip">{name}</li>
              ))}
            </ul>
          </div>
        )
      )}
    </div>
  </ProjectModal>
</Layout>

<style>
  /* ── Stack inside Modal ── */
  .stack_group {
    margin-bottom: 1.25rem;
  }

  .stack_group_label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #c084fc;
    margin-bottom: 0.5rem;
  }

  .stack_list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stack_chip {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: #d8b4fe;
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    white-space: nowrap;
  }
</style>
