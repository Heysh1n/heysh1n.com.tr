const fallbackTechnologies: Technology[] = [
  { name: 'Debian 13', category: 'os_tools' },
  { name: 'Zsh', category: 'os_tools' },
  { name: 'Termius', category: 'os_tools' },
  { name: 'Python', category: 'languages' },
  { name: 'TypeScript', category: 'languages' },
  { name: 'Java', category: 'languages' },
  { name: 'VLESS Protocol', category: 'networks' },
  { name: 'Hysteria 2', category: 'networks' },
  { name: 'Nukkit Core', category: 'game_servers' },
  { name: 'Endstone', category: 'game_servers' },
];

const fallbackSocials: HomePageSocial[] = [
  { platform: 'Github', url: 'https://github.com/Heysh1n', enabled: true },
  { platform: 'Telegram', url: 'https://t.me/heysh1n', enabled: true },
  { platform: 'Steam', url: 'https://steamcommunity.com/id/heysh1n/', enabled: true },
  { platform: 'NameMC', url: 'https://namemc.com/profile/Heysh1n', enabled: true },
  { platform: 'OnlyFans', url: 'https://onlyfans.com/hes1n', enabled: true },
  { platform: 'Reddit', url: 'https://reddit.com/user/heysh1n/', enabled: true },
];

const fallbackHomePage: HomePageGlobal = {
  name: 'Heysh1n',
  role: 'Backend Engineer',
  description:
    'Anonymous backend and systems persona focused on practical tooling, resilient server workflows, Linux-first environments, and hardware-adjacent experiments.',
  discord_id: '995737379417640961',
  discord_username: 'heysh1n',
  discord_tag: 'TR',
  socials: fallbackSocials,
};

const fetchPayloadGlobal = async <T,>(url: string): Promise<T | null> => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), payloadFetchTimeoutMs);

  try {
    const response = await fetch(url, {
      method: 'GET',
      signal: controller.signal,
    });

    if (!response.ok) {
      throw new Error(`Payload responded with ${response.status}`);
    }

    const payload = (await response.json()) as any;

    if (!payload || typeof payload !== 'object') {
      throw new Error('Payload returned an invalid global object');
    }

    // Handle payload globals returned directly or wrapped in { data: ... }
    const data =
      payload.data && typeof payload.data === 'object' && !Array.isArray(payload.data)
        ? payload.data
        : payload;

    return data as T;
  } catch (error) {
    const message =
      error instanceof Error && error.name === 'AbortError'
        ? `Payload request timed out after ${payloadFetchTimeoutMs}ms`
        : error instanceof Error
          ? error.message
          : String(error);
    console.warn(`Unable to fetch Payload global from ${url}: ${message}`);
    return null;
  } finally {
    clearTimeout(timeout);
  }
};

const fetchPayloadDocs = async <T,>(url: string): Promise<T[]> => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), payloadFetchTimeoutMs);

  try {
    const response = await fetch(url, { signal: controller.signal });

    if (!response.ok) {
      throw new Error(`Payload responded with ${response.status}`);
    }

    const payload = (await response.json()) as any;
    if (Array.isArray(payload)) {
      return payload as T[];
    }
    if (payload && Array.isArray(payload.docs)) {
      return payload.docs as T[];
    }
    if (payload && payload.data && Array.isArray(payload.data.docs)) {
      return payload.data.docs as T[];
    }
    if (payload && Array.isArray(payload.data)) {
      return payload.data as T[];
    }
    return [];
  } catch (error) {
    const message =
      error instanceof Error && error.name === 'AbortError'
        ? `Payload request timed out after ${payloadFetchTimeoutMs}ms`
        : error instanceof Error
          ? error.message
          : String(error);
    console.warn(`Unable to fetch Payload data from ${url}: ${message}`);
    return [];
  } finally {
    clearTimeout(timeout);
  }
};

const sanitizeId = (value: string): string =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9-_]+/g, '-')
    .replace(/^-+|-+$/g, '');

const textOrFallback = (value: string | null | undefined, fallback: string): string => {
  const trimmed = value?.trim();
  return trimmed || fallback;
};

const [homePage, fetchedProjects, fetchedTechnologies] = await Promise.all([
  fetchPayloadGlobal<HomePageGlobal>(homePageEndpoint),
  fetchPayloadDocs<Project>(projectsEndpoint),
  fetchPayloadDocs<Technology>(technologiesEndpoint),
]);

const heroName = textOrFallback(homePage?.name, fallbackHomePage.name ?? 'Heysh1n');
const heroRole = textOrFallback(homePage?.role, fallbackHomePage.role ?? 'Backend Engineer');
const heroDesc = textOrFallback(
  homePage?.description,
  fallbackHomePage.description ??
    'Anonymous backend and systems persona focused on practical tooling, resilient server workflows, Linux-first environments, and hardware-adjacent experiments.',
);

const projects = fetchedProjects.length > 0 ? fetchedProjects : fallbackProjects;
const technologies = fetchedTechnologies.length > 0 ? fetchedTechnologies : fallbackTechnologies;

const fallbackTagsMap: Record<string, string[]> = {
  sfcp: ['Python', 'FastAPI', 'HWID Security', 'AI Pipeline'],
  sfc: ['Python', 'CLI', 'TUI', 'Context Extractor'],
  'ahk-unix': ['C++20', 'Linux evdev', 'uinput', 'System Daemon'],
  'ai-skill': ['AI Agents', '5Whys', 'Prompt Engineering', 'Astro / Payload'],
};

const projectCards = projects.map((project, index) => {
  const fallbackProject = fallbackProjects.find(
    (fp) => fp.slug === project.slug || fp.title.toLowerCase() === project.title.toLowerCase()
  );

  // Parse project.markdown_description (fallback to detailedContent or fallbackProjects rich markdown, or description)
  const lexicalContent = project.detailedContent ? lexicalToMarkdown(project.detailedContent).trim() : '';
  const isPlaceholderLexical = !lexicalContent || lexicalContent.includes("Don't Worry Click on Block");

  const rawMarkdown =
    (typeof project.markdown_description === 'string' && project.markdown_description.trim()) ||
    (!isPlaceholderLexical ? lexicalContent : '') ||
    (fallbackProject?.markdown_description && fallbackProject.markdown_description.trim()) ||
    project.description ||
    '';

  const contentHtml = renderMarkdown(rawMarkdown);

  let tagsList: string[] = [];
  if (Array.isArray(project.tags)) {
    tagsList = project.tags;
  } else if (typeof project.tags === 'string' && project.tags.trim()) {
    tagsList = project.tags.split(',').map((t) => t.trim()).filter(Boolean);
  } else {
    tagsList = fallbackTagsMap[project.slug] || [];
  }

  const githubUrl = project.github_url || project.githubLink || null;
  const isSfcp = project.slug === 'sfcp' || project.title.toLowerCase().includes('collector pro');
  const ctaUrl = project.cta_url || (isSfcp ? 'https://t.me/heysh1n' : githubUrl);
  const ctaLabel =
    project.cta_label ||
    (isSfcp
      ? 'Купить ключ'
      : githubUrl
        ? 'Перейти на GitHub'
        : 'Перейти к проекту');

  return {
    ...project,
    contentHtml,
    tagsList,
    ctaUrl,
    ctaLabel,
    githubUrl,
    demoUrl: project.demo_url || null,
    dialogId: `modal-project-${sanitizeId(project.slug || String(project.id ?? index))}`,
    tone: index % 2 === 0 ? 'purple' : 'red',
  };
});

const stackGroups = (Object.keys(categoryLabels) as TechnologyCategory[]).map((category) => ({
  category,
  label: categoryLabels[category],
  names: technologies
    .filter((technology) => technology.category === category)
    .map((technology) => technology.name),
}));

const enabledSocials = homePage?.socials?.filter((s) => s.enabled !== false);
const socials = enabledSocials && enabledSocials.length > 0 ? enabledSocials : fallbackSocials;

const discordId = textOrFallback(homePage?.discord_id, fallbackHomePage.discord_id ?? '995737379417640961');
const discordUsername = textOrFallback(homePage?.discord_username, fallbackHomePage.discord_username ?? 'heysh1n');
const discordTag = textOrFallback(homePage?.discord_tag, fallbackHomePage.discord_tag ?? 'TR');

const getSocialMeta = (rawUrl: string, explicitPlatform?: string | null) => {
  let normalizedUrl = (rawUrl || '').trim();
  if (normalizedUrl && !/^https?:\/\//i.test(normalizedUrl)) {
    normalizedUrl = `https://${normalizedUrl}`;
  }

  let parsedUrl: URL | null = null;
  try {
    parsedUrl = new URL(normalizedUrl);
  } catch {
    parsedUrl = null;
  }

  const hostname = parsedUrl ? parsedUrl.hostname.toLowerCase().replace(/^www\./, '') : '';
  const domain = hostname;

  let platform = (explicitPlatform || '').trim().toLowerCase();
  if (!platform && hostname) {
    if (hostname.includes('steampowered.com') || hostname.includes('steamcommunity.com')) {
      platform = 'steam';
    } else if (hostname === 't.me' || hostname.includes('telegram.')) {
      platform = 'telegram';
    } else if (hostname === 'x.com' || hostname.includes('twitter.')) {
      platform = 'x';
    } else if (hostname.includes('discord.')) {
      platform = 'discord';
    } else if (hostname.includes('youtube.') || hostname === 'youtu.be') {
      platform = 'youtube';
    } else if (hostname.includes('github.')) {
      platform = 'github';
    } else if (hostname.includes('reddit.')) {
      platform = 'reddit';
    } else {
      const parts = hostname.split('.');
      platform = parts.length > 1 ? parts[parts.length - 2] : parts[0];
    }
  }
  platform = platform || 'link';

  const iconUrl = `https://cdn.simpleicons.org/${encodeURIComponent(platform)}/white`;
  const fallbackFavicon = domain
    ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`
    : '/assets/svg/github.svg';

  const title = (explicitPlatform && explicitPlatform.trim()) || `${platform}.link`;

  const cleaned = parsedUrl ? parsedUrl.pathname.replace(/^[/@]+/, '').replace(/\/+$/, '') : '';
  const subText = cleaned
    ? cleaned.includes('/')
      ? cleaned.split('/').pop() || cleaned
      : cleaned
    : domain || platform;
  const handle = subText.startsWith('@') ? subText : `@${subText}`;

  return {
    platform,
    domain,
    title,
    subText,
    handle,
    iconUrl,
    fallbackFavicon,
    url: parsedUrl ? parsedUrl.toString() : normalizedUrl || '#',
  };
};
---
<Layout discordId={discordId}>
  <main class="w-full max-w-5xl mx-auto p-4 flex flex-col justify-center items-center">
    <section class="bento-container">
      <div class="hero_card glassmorphism h-full flex flex-col">
        <span class="hero_title">hero.md</span>
        <span class="hero_item">{heroName}</span>
        <span class="hero_item mb-4">{heroRole}</span>
        <button 
          type="button" 
          class="w-full text-center py-2 px-4 rounded-lg bg-white/[0.04] border border-white/10 hover:bg-white/[0.08] hover:border-white/20 transition-colors text-sm text-zinc-200 mt-4 cursor-pointer"
          data-modal-target="modal-stack"
        >
          [ Open stack.yml ]
        </button>
      </div>

      <div class="env_card glassmorphism">
        <DiscordProfileIsland
          client:load
          discordId={discordId}
          username={discordUsername}
          displayName={heroName}
          fallbackTag={discordTag}
        />
      </div>

      <div class="player_card glassmorphism h-full flex flex-col justify-between items-center text-center">
        <div class="player_header w-full">
          <span class="hero_title">player.sh</span>
        </div>
        <MusicWidgetIsland
          client:load
          backendUrl={backendUrl}
        />
      </div>

      {/* ── Project Cards (clickable → open modal) ── */}
      {projectCards.map((project) => (
        <button
          type="button"
          class="project_card glassmorphism cursor-pointer"
          data-modal-target={project.dialogId}
          aria-label={`Открыть проект ${project.title}`}
        >
          <div class="project_card_header">
            <span class="project_title">{project.title}</span>
            <span class="project_card_indicator" aria-hidden="true" title="Подробнее о проекте">
              <svg class="indicator_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
          <p class="project_description line-clamp-3">{project.description}</p>
          <div class="project_card_footer">
            {project.tagsList && project.tagsList.length > 0 && (
              <div class="project_card_tags">
                {project.tagsList.slice(0, 3).map((tag) => (
                  <span class="project_card_tag">{tag}</span>
                ))}
              </div>
            )}
            {project.status && (
              <span class="project_status" data-status={project.status}>
                {statusLabels[project.status]}
              </span>
            )}
          </div>
        </button>
      ))}

      <hr class="social-divider" />

      {/* ── Social Links from HomePage Global ── */}
      <div class="socials-container">
        {socials.map((social) => {
          const meta = getSocialMeta(social.url, social.platform);
          return (
            <a
              class="social-card glassmorphism"
              href={meta.url}
              target="_blank"
              rel="noopener noreferrer"
              title={meta.title}
            >
              <img
                src={meta.iconUrl}
                alt={meta.platform}
                class="social-icon"
                loading="lazy"
                onerror={`this.onerror=null; this.src='${meta.fallbackFavicon}';`}
              />
              <div class="social-info">
                <span class="social-title">{meta.title}</span>
                <span class="social-handle">{meta.handle}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>

  {/* ── Project Modals (Reusable <ProjectModal /> with native <dialog>) ── */}
  {projectCards.map((project) => (
    <ProjectModal
      id={project.dialogId}
      title={project.title}
      description={project.description}
      contentHtml={project.contentHtml}
      tags={project.tagsList}
      status={project.status ? statusLabels[project.status] : null}
      statusCode={project.status}
      ctaUrl={project.ctaUrl}
      ctaLabel={project.ctaLabel}
      githubUrl={project.githubUrl}
      demoUrl={project.demoUrl}
    />
  ))}

  {/* ── Stack Modal (Reusable <ProjectModal />) ── */}
  <ProjectModal id="modal-stack" title="Technology Stack">
    <div class="modal_body">
      {stackGroups.map((group) =>
        group.names.length > 0 && (
          <div class="stack_group">
            <h3 class="stack_group_label">{group.label}</h3>
            <ul class="stack_list">
              {group.names.map((name) => (
                <li class="stack_chip">{name}</li>
              ))}
            </ul>
          </div>
        )
      )}
    </div>
  </ProjectModal>
</Layout>

<style>
  /* ── Interactive Project Card Styling & Hover Indicator ── */
  .project_card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
    cursor: pointer;
    text-align: left;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.22s ease,
                box-shadow 0.22s ease;
    border: 1px solid rgba(196, 140, 255, 0.35);
    background: rgba(18, 5, 24, 0.55);
    border-radius: 14px;
    width: 100%;
    color: inherit;
    position: relative;
    overflow: hidden;
  }

  .project_card:hover {
    transform: translateY(-2px);
    border-color: rgba(196, 140, 255, 0.55);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 20px rgba(168, 85, 247, 0.25);
  }

  .project_card_header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.6rem;
    width: 100%;
  }

  .project_card_indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    flex-shrink: 0;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
  }

  .indicator_icon {
    width: 1rem;
    height: 1rem;
  }

  .project_card:hover .project_card_indicator {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: #f4f4f5;
    transform: translate(2px, -2px);
  }

  .project_description {
    color: #a1a1aa;
    font-size: clamp(0.85rem, 0.78rem + 0.25vw, 0.95rem);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
