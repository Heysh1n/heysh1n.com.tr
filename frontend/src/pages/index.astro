type ProjectStatus = 'active' | 'in_progress' | 'archived';
type TechnologyCategory = 'os_tools' | 'languages' | 'networks' | 'game_servers';

type RichTextNode = {
  children?: RichTextNode[];
  fields?: {
    url?: string;
  };
  format?: number | string;
  listType?: string;
  tag?: string;
  text?: string;
  type?: string;
  url?: string;
};

type RichTextContent = {
  root?: RichTextNode;
};

type Project = {
  id?: number | string;
  title: string;
  slug: string;
  description: string;
  markdown_description?: string | null;
  cta_label?: string | null;
  cta_url?: string | null;
  github_url?: string | null;
  githubLink?: string | null;
  demo_url?: string | null;
