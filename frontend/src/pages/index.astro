const projectsEndpoint = `${backendUrl}/api/projects?limit=100&depth=1`;
const technologiesEndpoint = `${backendUrl}/api/technologies?limit=100&depth=1`;
const payloadFetchTimeoutMs = 25000;

const categoryLabels: Record<TechnologyCategory, string> = {
