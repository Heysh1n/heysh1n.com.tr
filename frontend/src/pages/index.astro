  languages: 'Languages',
  networks: 'Networks',
  game_servers: 'Game Servers',
  frameworks: 'Frameworks',
  databases: 'Databases',
  devops: 'DevOps',
  security: 'Security',
  ui_ux: 'UI/UX',
};

const statusLabels: Record<ProjectStatus, string> = {
  active: 'Active',
  in_progress: 'In Progress',
  archived: 'Archived',
};

const fallbackProjects: Project[] = [
